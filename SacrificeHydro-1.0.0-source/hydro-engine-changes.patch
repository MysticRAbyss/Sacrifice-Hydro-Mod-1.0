+}
+// the Kraken's four tentacles: Persephone's Meanstalks at 75% of their size, rising around the
+// whirlpool's eye; each grabs, crushes and flings a creature of any side, wizards included
+enum krakenTentacleScale=0.75f;
+void krakenTentacles(B)(ref Erupt!B erupt,ObjectState!B state){
+	auto ms=Meanstalks!B(erupt.wizard,erupt.side,erupt.position,erupt.spell);
+	ms.hydro=true;
+	ms.hydroScale=krakenTentacleScale;
+	foreach(i;0..Meanstalks!B.maxVines){
+		auto a=(i+0.5f)*0.5f*pi!float+state.uniform(-0.2f,0.2f);
+		auto position=erupt.position+state.uniform(4.0f,7.0f)*Vector3f(sin(a),cos(a),0.0f);
+		position.z=state.getHeight(position);
+		Meanstalk vine;
+		vine.position=Vector3f(position.x,position.y,position.z-60.0f*krakenTentacleScale);
+		vine.goal=vine.position+Vector3f(0.0f,0.0f,60.0f*krakenTentacleScale);
+		vine.tip=vine.goal;
+		vine.timer=cast(int)(erupt.spell.duration*updateFPS);
+		vine.mode=MeanstalkMode.growing;
+		meanstalkCurveSetup(vine,krakenTentacleScale);
+		ms.vines[ms.numVines++]=vine;
+	}
+	state.addEffect(move(ms));
+}
+bool isHydroEnemy(B)(ref MovingObject!B obj,int side,ObjectState!B state){
+	return obj.side!=side&&state.sides.getStance(side,obj.side)!=Stance.ally;
+}
+bool updateHydroBig(B)(ref VortexEffect!B vortex,ObjectState!B state){
+	final switch(cast(HydroBig)vortex.hydroBig){
+		case HydroBig.none: return false;
+		case HydroBig.acidRain: return updateAcidRain(vortex,state);
+		case HydroBig.tsunami: return updateTsunami(vortex,state);
+		case HydroBig.kraken: return updateKraken(vortex,state);
+	}
+}
