+			char[4] t=tag; auto c=t in cre8s; auto sp=t in spels;
+			auto name=c?texts.get(c.name,""):sp?texts.get(sp.name,""):"";
+			writefln("SPELL %s %s %d %s %s",god,kind==0?"creature":"spell",i,[t[3],t[2],t[1],t[0]],name);
