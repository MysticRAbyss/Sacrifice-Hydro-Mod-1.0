+// --- Hydro mod: the Tidal Wall (a Firewall with hydro set) ---
+// a wall of falling water over a reef: enemies inside it are slowed by 90% and take damage
+// (120 per second), its own side and allies pass freely, and enemy missiles are stopped by it
+enum tidalWallDamagePerSecond=120.0f;
+bool updateTidalWall(B)(ref Firewall!B firewall,ObjectState!B state,bool active){
+	with(firewall){
+		static void soak(ProximityEntry target,ObjectState!B state,SacSpell!B spell,int attacker,int side,Firewall!B* firewall){
+			state.movingObjectById!((ref obj,attacker,side,state){
+				if(obj.side==side||state.sides.getStance(side,obj.side)==Stance.ally) return;
+				obj.creatureStats.effects.hydroWallFrames=max(obj.creatureStats.effects.hydroWallFrames,updateFPS/4); // -90% speed while in the water
+				if(obj.creatureState.speed>obj.speedOnGround(state)) obj.creatureState.speed=obj.speedOnGround(state); // no coasting through it
+				dealDamage(obj,tidalWallDamagePerSecond/updateFPS,attacker,side,DamageMod.none,state);
+			},(){})(target.id,attacker,side,state);
+		}
+		auto wall=WallPosition(center,direction,left,right,top,wallThickness);
+		if(active) wallTargets!(soak,defaultWallFilter)(wall,state,firewall.spell,firewall.wizard,firewall.side,&firewall);
+		auto orthogonal=Vector3f(direction.y,-direction.x,0.0f);
+		auto drop=SacParticle!B.get(ParticleType.hydroDroplet), foam=SacParticle!B.get(ParticleType.hydroFoam);
+		final switch(status){
+			case FirewallStatus.growing:
+				top=min(top+growSpeed,wallHeight);
+				auto expansionSpeed=spell.effectRange/FirewallCasting!B.castingLimit;
+				bool check(Vector3f position){
+					if((position-center).lengthsqr>spell.effectRange^^2) return false;
+					static void handleCollision(ProximityEntry entry,bool* found,ObjectState!B state){
+						if(state.isValidTarget(entry.id,TargetType.building))
+							*found=true;
+					}
+					Vector3f[2] hitbox=[position,position];
+					bool found=false;
+					state.proximity.collide!handleCollision(hitbox,&found,state);
+					return !found&&state.isOnGround(position);
+				}
+				if(!leftStopped){
+					auto cand=left-expansionSpeed;
+					if(check(get(cand,state))) left=cand;
+					else leftStopped=true;
+				}
+				if(!rightStopped){
+					auto cand=right+expansionSpeed;
+					if(check(get(cand,state))) right=cand;
+					else rightStopped=true;
+				}
+				if(leftStopped&&rightStopped&&top==wallHeight)
+					status=FirewallStatus.stationary;
+				break;
+			case FirewallStatus.stationary:
+				break;
+			case FirewallStatus.shrinking:
+				top=max(top-shrinkSpeed,0.0f);
+				if(top==0.0f) return false;
+				break;
+		}
+		if(state.enableParticles&&right>left){
+			foreach(i;0..3){ // water pouring down the wall
+				auto t=state.uniform(left,right);
+				auto wscale=scale(t);
+				auto height=firewall.height(t)*wscale;
+				auto p=get(t,state)+Vector3f(0.0f,0.0f,height*state.uniform(0.6f,1.0f))+0.3f*wallThickness*state.uniform(-0.45f,0.45f)*orthogonal;
+				state.addParticle(Particle!B(drop,p,Vector3f(0.0f,0.0f,-state.uniform(4.0f,7.0f)),state.uniform(0.9f,1.6f)*wscale,cast(int)(0.9f*updateFPS),0));
+			}
+			if(frame%3==0){ // foam where it hits the reef
+				auto t=state.uniform(left,right);
+				auto p=get(t,state)+Vector3f(0.0f,0.0f,0.3f)+0.4f*wallThickness*state.uniform(-0.45f,0.45f)*orthogonal;
+				auto v=0.8f*state.uniform(-1.0f,1.0f)*orthogonal+Vector3f(0.0f,0.0f,0.6f);
+				state.addParticle(Particle!B(foam,p,v,state.uniform(1.0f,1.8f)*scale(t),cast(int)(0.8f*updateFPS),0));
+			}
+		}
+		if(++frame>=FirewallCasting!B.castingLimit+spell.duration*updateFPS)
+			status=FirewallStatus.shrinking;
+		return true;
+	}
+}
+// true if the missile flew into an enemy Tidal Wall (it is then stopped with a splash)
+bool hydroWallBlocks(T,B)(ref T missile,ObjectState!B state){
+	static if(is(typeof(missile.position)==Vector3f)&&is(typeof(missile.side):int)){
+		auto effects=&state.obj.opaqueObjects.effects;
+		if(!effects.firewalls.length&&!effects.firewallCastings.length) return false;
+		bool hit=false;
+		void test(ref Firewall!B fw){
+			if(hit||!fw.hydro||fw.top<1.0f||fw.right<=fw.left) return;
+			if(missile.side==fw.side||state.sides.getStance(fw.side,missile.side)==Stance.ally) return;
+			Vector3f[2] box=[missile.position-Vector3f(0.3f,0.3f,0.3f),missile.position+Vector3f(0.3f,0.3f,0.3f)];
+			if(isInWall(box,WallPosition(fw.center,fw.direction,fw.left,fw.right,fw.top,0.5f*fw.wallThickness),state)) hit=true;
+		}
+		foreach(ref fw;effects.firewalls.data) test(fw);
+		foreach(ref fc;effects.firewallCastings.data) test(fc.firewall);
+		if(hit){
+			animateWaterSplash(missile.position,state,0.35f);
+			{ import std.process:environment; if(environment.get("HYDRO_TEST_CAST","").length) stderr.writeln("hydro test: tidal wall stopped a ",T.stringof); }
+		}
+		return hit;
+	}else return false;
+}
