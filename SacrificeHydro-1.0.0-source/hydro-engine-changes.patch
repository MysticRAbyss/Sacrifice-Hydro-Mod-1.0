+// Tsunami: a wall of water 40 m wide rolls forward; every enemy it reaches is hit once and swept
+// along - small creatures far, big ones only a short way
+enum tsunamiLead=25.0f, tsunamiWidth=40.0f, tsunamiSpeed=20.0f, tsunamiTravel=150.0f, tsunamiHeight=14.0f;
+float tsunamiProgress(B)(ref VortexEffect!B vortex){ // how far the front has rolled
+	return min(tsunamiTravel,tsunamiSpeed*vortex.frame/updateFPS);
+}
+bool updateTsunami(B)(ref VortexEffect!B vortex,ObjectState!B state){
+	with(vortex){
+		auto dir=Vector3f(hydroDir.x,hydroDir.y,0.0f), side_=Vector3f(-hydroDir.y,hydroDir.x,0.0f);
+		auto dist=tsunamiProgress(vortex);
+		auto front=position+dist*dir;
+		bool rolling=dist<tsunamiTravel;
+		auto total=cast(int)(tsunamiTravel/tsunamiSpeed*updateFPS)+updateFPS;
+		if(rolling){
+			Vector3f[2] hitbox=[front-Vector3f(tsunamiWidth,tsunamiWidth,10.0f),front+Vector3f(tsunamiWidth,tsunamiWidth,20.0f)];
+			static void sweep(ProximityEntry target,ObjectState!B state,VortexEffect!B* vortex,Vector3f front){
+				state.movingObjectById!((ref obj,vortex,front,state){
+					if(!obj.isHydroEnemy(vortex.side,state)) return;
+					if(obj.creatureState.mode.among(CreatureMode.dead,CreatureMode.dying)) return;
+					if(obj.creatureStats.effects.hydroWaveId==vortex.hydroTarget) return; // already hit by this wave
+					auto rel=obj.position-front;
+					auto along=dot(rel.xy,vortex.hydroDir), across=dot(rel.xy,Vector2f(-vortex.hydroDir.y,vortex.hydroDir.x));
+					if(along>1.5f||along<-4.0f||abs(across)>0.5f*tsunamiWidth) return;
+					obj.creatureStats.effects.hydroWaveId=vortex.hydroTarget;
+					dealSpellDamage(obj,vortex.rangedAttack,vortex.attacker,vortex.side,Vector3f(vortex.hydroDir.x,vortex.hydroDir.y,0.3f),DamageMod.none,state);
+					if(obj.creatureState.movement==CreatureMovement.flying) return;
+					// small creatures are swept far, big ones only a short way
+					auto size=min(1.0f,600.0f/max(1.0f,obj.creatureStats.maxHealth));
+					auto push=2.0f*(obj.isWizard?6.0f:5.0f+13.0f*size); // carried twice as far as before
+					obj.catapult(vortex.side,Vector3f(push*vortex.hydroDir.x,push*vortex.hydroDir.y,4.5f+5.0f*size),state,true);
+				},(){})(target.id,vortex,front,state);
+			}
+			collisionTargets!sweep(hitbox,state,&vortex,front);
+			if(state.enableParticles){ // spray off the crest and foam at its foot
+				auto drop=SacParticle!B.get(ParticleType.hydroDroplet), foam=SacParticle!B.get(ParticleType.hydroFoam);
+				foreach(i;0..6){
+					auto t=state.uniform(-0.5f,0.5f)*tsunamiWidth;
+					auto p=front+t*side_; p.z=state.getHeight(p)+tsunamiHeight*state.uniform(0.8f,1.05f);
+					auto v=dir*tsunamiSpeed*state.uniform(0.9f,1.3f)+Vector3f(0.0f,0.0f,state.uniform(1.0f,4.0f));
+					state.addParticle(.Particle!B(drop,p,v,state.uniform(1.0f,2.0f),cast(int)(0.7f*updateFPS),0));
+				}
+				foreach(i;0..2){
+					auto t=state.uniform(-0.5f,0.5f)*tsunamiWidth;
+					auto p=front+t*side_+dir*0.5f; p.z=state.getHeight(p)+0.4f;
+					state.addParticle(.Particle!B(foam,p,dir*tsunamiSpeed*0.8f+Vector3f(0.0f,0.0f,1.0f),state.uniform(2.0f,3.5f),cast(int)(0.8f*updateFPS),0));
+				}
+			}
+		}
+		return ++frame<=total;
+	}
+}
+
+// Kraken: a giant whirlpool drags everyone in it (both sides) towards its eye, where four huge
+// tentacles (krakenTentacles) rise and grab what comes close
+enum krakenEyeRadius=7.0f, krakenSlamEvery=cast(int)(1.5f*updateFPS), krakenRise=cast(int)(1.2f*updateFPS);
+bool updateKraken(B)(ref VortexEffect!B vortex,ObjectState!B state){
+	with(vortex){
+		auto radius=rangedAttack.effectRange;
+		auto total=cast(int)(duration*updateFPS);
+		spin+=1.2f/updateFPS;
+		bool active=frame<total-updateFPS;
+		Vector3f[2] hitbox=[Vector3f(position.x-radius,position.y-radius,position.z-10.0f),Vector3f(position.x+radius,position.y+radius,position.z+20.0f)];
+		static void pull(ProximityEntry target,ObjectState!B state,VortexEffect!B* vortex,float radius){
+			state.movingObjectById!((ref obj,vortex,radius,state){ // an ultimate: it drags everyone, friend and foe
+				if(obj.creatureState.movement!=CreatureMovement.onGround||obj.creatureStats.effects.fixed) return;
+				if(obj.creatureState.mode.among(CreatureMode.dead,CreatureMode.dying)) return;
+				auto offset=obj.position.xy-vortex.position.xy;
+				auto dist=offset.length;
+				if(dist>radius||dist<1.5f) return;
+				obj.creatureStats.effects.hydroWadeFrames=max(obj.creatureStats.effects.hydroWadeFrames,updateFPS/4); // half speed in the current
+				auto tangent=Vector2f(-offset.y,offset.x)/dist;
+				auto step=(-offset/dist*(5.0f+5.0f*dist/radius)+tangent*1.5f)/updateFPS; // dragged inwards, swirling
+				auto p=obj.position+Vector3f(step.x,step.y,0.0f);
+				if(state.isOnGround(p)){ p.z=state.getGroundHeight(p); obj.position=p; }
+			},(){})(target.id,vortex,radius,state);
+		}
+		if(active) collisionTargets!pull(hitbox,state,&vortex,radius);
+		if(state.enableParticles&&active&&frame%2==0){ // spray thrown up around the rim
+			auto drop=SacParticle!B.get(ParticleType.hydroDroplet);
+			auto a=state.uniform(0.0f,2.0f*pi!float), rr=state.uniform(0.4f,1.0f)*radius;
+			auto dir_=Vector3f(cos(a),sin(a),0.0f), tangent=Vector3f(-sin(a),cos(a),0.0f);
+			auto p=position+rr*dir_; p.z=state.getHeight(p)+0.3f;
+			state.addParticle(.Particle!B(drop,p,tangent*state.uniform(3.0f,6.0f)+Vector3f(0.0f,0.0f,state.uniform(2.0f,5.0f)),state.uniform(0.8f,1.6f),cast(int)(0.8f*updateFPS),0));
+		}
+		return ++frame<=total;
+	}
+}
+// how far the Kraken's tentacles are out of the water (0..1) and how much they bend over (0..1)
+float krakenRiseOf(B)(ref VortexEffect!B vortex){
+	auto total=cast(int)(vortex.duration*updateFPS);
+	return min(1.0f,float(vortex.frame)/krakenRise,max(0.0f,float(total-vortex.frame)/updateFPS));
+}
+float krakenSlamOf(B)(ref VortexEffect!B vortex){
+	if(vortex.frame<krakenRise) return 0.0f;
+	auto ph=float((vortex.frame-krakenRise)%krakenSlamEvery)/krakenSlamEvery; // 0.5: impact
+	if(ph<0.35f) return 0.0f;
+	if(ph<0.5f) return (ph-0.35f)/0.15f;
+	return max(0.0f,1.0f-(ph-0.5f)/0.35f);
+}
+
+// --- Hydro mod: Geyser and Healing Spring (cast through EruptCasting) ---
+bool castHydroGround(B)(int side,Vector3f position,ubyte kind,ManaDrain!B manaDrain,SacSpell!B spell,ObjectState!B state){
+	if(isNaN(position.x)||isNaN(position.y)) return false;
+	if(state.isOnGround(position)) position.z=state.getGroundHeight(position);
+	else position.z=state.getHeight(position);
+	auto e=Erupt!B(manaDrain.wizard,side,position,spell);
+	e.hydroKind=kind;
+	state.addEffect(EruptCasting!B(manaDrain,e));
+	return true;
+}
+void animateHydroGroundCasting(B)(ref Erupt!B erupt,ObjectState!B state){ // water starts welling up at the spot
+	if(!state.enableParticles||state.frame%3) return;
+	auto drop=SacParticle!B.get(ParticleType.hydroDroplet);
+	auto a=state.uniform(0.0f,2.0f*pi!float), r=state.uniform(0.0f,1.5f);
+	auto p=erupt.position+Vector3f(r*cos(a),r*sin(a),0.2f);
+	state.addParticle(Particle!B(drop,p,Vector3f(0.0f,0.0f,state.uniform(1.0f,3.0f)),state.uniform(0.8f,1.3f),cast(int)(0.5f*updateFPS),0));
+}
+// Geyser: a dome of water swells out of the ground over the target spot, carrying everyone standing
+// there up on top of it (they cannot walk off); then it bursts: everyone in the zone is flung outwards,
+// scattered from the middle to the edge, and every enemy among them takes the full damage
+enum geyserBurstFrame=cast(int)(1.6f*updateFPS), geyserFrames=cast(int)(4.0f*updateFPS);
+enum geyserDomeHeight=3.0f;
+float geyserDome(B)(ref Erupt!B erupt,float dist){ // height of the dome above the ground at that distance
+	if(erupt.frame>=geyserBurstFrame) return 0.0f;
+	auto r=erupt.spell.effectRange;
+	if(dist>=r) return 0.0f;
+	auto t=float(erupt.frame)/geyserBurstFrame;
+	auto grow=t*t*(3.0f-2.0f*t);
+	auto q=dist/r;
+	return geyserDomeHeight*grow*(1.0f-q*q);
+}
+bool isGeyserEnemy(B)(ref MovingObject!B obj,int side,ObjectState!B state){
+	return obj.side!=side&&state.sides.getStance(side,obj.side)!=Stance.ally;
+}
+bool updateGeyser(B)(ref Erupt!B erupt,ObjectState!B state){
+	with(erupt){
+		++frame;
+		auto drop=SacParticle!B.get(ParticleType.hydroDroplet), foam=SacParticle!B.get(ParticleType.hydroFoam);
+		auto radius=spell.effectRange;
+		if(frame<geyserBurstFrame){ // the dome swells, the enemies on it ride up
+			if(frame%(updateFPS/10)==0) state.addEffect(ScreenShake(position,updateFPS/10,0.8f,120.0f));
+			Vector3f[2] hitbox=[Vector3f(position.x-radius,position.y-radius,position.z-10.0f),Vector3f(position.x+radius,position.y+radius,position.z+20.0f)];
+			static void lift(ProximityEntry target,ObjectState!B state,Erupt!B* erupt){
+				state.movingObjectById!((ref obj,erupt,state){ // everyone on the dome rides it, friend and foe
+					if(obj.creatureState.movement==CreatureMovement.flying) return;
+					if(obj.creatureState.mode.among(CreatureMode.dead,CreatureMode.dying)) return;
+					auto dist=(obj.position.xy-erupt.position.xy).length;
+					if(dist>=erupt.spell.effectRange) return;
+					if(obj.creatureState.movement==CreatureMovement.onGround){ // carried: held still, floating with the water
+						if(!obj.canCatapult) return;
+						obj.catapult(erupt.side,Vector3f(0.0f,0.0f,0.0f),state,true);
+					}
+					obj.creatureStats.effects.hydroLiftFrames=2;
+					obj.creatureStats.effects.antiGravityTime=state.frame;
+					obj.creatureState.fallingVelocity=Vector3f(0.0f,0.0f,0.0f);
+					obj.creatureState.speed=0.0f;
+					auto p=obj.position;
+					p.z=state.getHeight(p)+geyserDome(*erupt,dist);
+					obj.position=p;
+				},(){})(target.id,erupt,state);
+			}
+			collisionTargets!lift(hitbox,state,&erupt);
+			if(state.enableParticles) foreach(i;0..4){ // water bubbling over the dome
+				auto a=state.uniform(0.0f,2.0f*pi!float), r=state.uniform(0.0f,0.9f)*radius;
+				auto p=position+Vector3f(r*cos(a),r*sin(a),0.0f);
+				p.z=state.getHeight(p)+geyserDome(erupt,r)+0.2f;
+				state.addParticle(Particle!B(i?drop:foam,p,Vector3f(0.0f,0.0f,state.uniform(1.0f,3.0f)),state.uniform(0.8f,1.5f),cast(int)(0.6f*updateFPS),0));
+			}
+		}else if(frame==geyserBurstFrame){
+			geyserBurst(erupt,state);
+		}else if(state.enableParticles&&frame<geyserFrames-updateFPS/2){ // the column of water, falling back as spray
+			auto fade=1.0f-float(frame-geyserBurstFrame)/(geyserFrames-geyserBurstFrame);
+			foreach(i;0..cast(int)(16*fade)+2){
+				auto a=state.uniform(0.0f,2.0f*pi!float), r=state.uniform(0.0f,2.0f);
+				auto p=position+Vector3f(r*cos(a),r*sin(a),0.3f);
+				auto v=Vector3f(2.5f*cos(a)*r,2.5f*sin(a)*r,state.uniform(14.0f,24.0f)*(0.4f+0.6f*fade));
+				state.addParticle(Particle!B(i%4?drop:foam,p,v,state.uniform(1.2f,2.4f),cast(int)(state.uniform(1.4f,2.2f)*updateFPS),0));
+			}
+		}
+		return frame<=geyserFrames;
+	}
+}
+void geyserBurst(B)(ref Erupt!B erupt,ObjectState!B state){
+	auto radius=erupt.spell.effectRange;
+	auto position=erupt.position;
+	Vector3f[2] hitbox=[Vector3f(position.x-radius,position.y-radius,position.z-10.0f),Vector3f(position.x+radius,position.y+radius,position.z+30.0f)];
+	static struct Hit{ int[] ids; }
+	Hit hit;
+	static void collect(ProximityEntry target,ObjectState!B state,Hit* hit){ hit.ids~=target.id; }
+	collisionTargets!collect(hitbox,state,&hit);
+	int thrown=0,damaged=0;
+	foreach(id;hit.ids){
+		if(!state.isValidTarget(id)) continue;
+		auto type=state.targetTypeFromId(id);
+		if(type==TargetType.creature){
+			state.movingObjectById!((ref obj,erupt,state,thrown,damaged){
+				if(obj.creatureState.mode.among(CreatureMode.dead,CreatureMode.dying)) return;
+				auto diff=obj.position.xy-erupt.position.xy;
+				auto dist=diff.length;
+				if(dist>=erupt.spell.effectRange) return;
+				obj.creatureStats.effects.hydroLiftFrames=0;
+				Vector2f dir=dist>0.5f?diff/dist:state.uniformDirection!(float,2)();
+				// the same damage everywhere in the zone, to enemies only; everyone is thrown
+				if(obj.isGeyserEnemy(erupt.side,state)){
+					dealSpellDamage(obj,erupt.spell,erupt.wizard,erupt.side,Vector3f(dir.x,dir.y,1.0f).normalized,DamageMod.none,state);
+					++*damaged;
+				}else obj.creatureStats.effects.hydroSoftLandFrames=5*updateFPS; // friends land unhurt
+				if(obj.creatureState.movement==CreatureMovement.flying) return;
+				// flung outwards; where they land is spread between the middle and the edge and beyond
+				auto out_=4.0f+9.0f*dist/erupt.spell.effectRange+state.uniform(0.0f,3.0f);
+				obj.catapult(erupt.side,Vector3f(out_*dir.x,out_*dir.y,state.uniform(9.0f,12.0f)),state,true);
+				++*thrown;
+			},(){})(id,&erupt,state,&thrown,&damaged);
+		}
+	}
+	{ import hydromod:hydroSound; playSoundAt(hydroSound("geyser","tpre"),position,state,eruptGain2); }
+	state.addEffect(ScreenShake(position,updateFPS/3,3.0f,100.0f));
+	animateWaterSplash(position+Vector3f(0.0f,0.0f,1.0f),state,3.5f);
+	{ import std.process:environment; if(environment.get("HYDRO_TEST_CAST","").length) stderr.writeln("hydro test: geyser burst damaged ",damaged," thrown ",thrown); }
+}
+// Healing Spring: a spring opens at the target's feet (a VortexEffect that heals instead)
+bool healingSpring(B)(ref Erupt!B erupt,ObjectState!B state){
+	{ import hydromod:hydroSound; playSoundAt(hydroSound("spring","laeh"),erupt.position,state,4.0f); }
+	auto vortex=VortexEffect!B(erupt.side,erupt.position,erupt.spell);
+	vortex.hydroSpring=true;
+	vortex.attacker=erupt.wizard;
+	vortex.durationFactor=erupt.spell.duration/2.0f;
+	state.addEffect(move(vortex));
+	return true;
+}
+bool updateHealingSpring(B)(ref VortexEffect!B vortex,ObjectState!B state){
+	with(vortex){
+		auto radius=rangedAttack.effectRange;
+		auto total=cast(int)(duration*updateFPS);
+		if(state.enableParticles&&frame<total-updateFPS/3){ // a fine rain falling into the blue zone
+			auto drop=SacParticle!B.get(ParticleType.hydroDroplet);
+			foreach(i;0..cast(int)(5.0f*(radius/8.0f)^^2/3.0f)+1){ // denser the bigger the zone
+				auto a=state.uniform(0.0f,2.0f*pi!float), r=sqrt(state.uniform(0.0f,1.0f))*radius;
+				auto p=position+Vector3f(r*cos(a),r*sin(a),0.0f);
+				auto ground=state.getHeight(p);
+				auto h=state.uniform(3.0f,6.0f);
