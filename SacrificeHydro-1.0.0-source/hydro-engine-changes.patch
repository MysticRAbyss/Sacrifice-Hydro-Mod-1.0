+			vortex.position=erupt.position-tsunamiLead*Vector3f(dir.x,dir.y,0.0f);
+			vortex.position.z=state.getHeight(vortex.position);
+			vortex.hydroTarget=erupt.wizard*7919+state.frame; // marks the creatures this wave already hit
+			playSoundAt(hydroSound("tsunami","gxtv"),erupt.position,state,8.0f);
+			break;
+		case HydroBig.kraken:
+			playSoundAt(hydroSound("kraken","gxtv"),erupt.position,state,8.0f);
