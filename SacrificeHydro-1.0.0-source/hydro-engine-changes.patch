+// Acid Rain: a dark cloud over the spot pours corrosive rain; every enemy under it (wizards too)
+// loses health while it rains
+enum acidRainDamagePerSecond=140.0f, acidCloudHeight=18.0f;
+bool updateAcidRain(B)(ref VortexEffect!B vortex,ObjectState!B state){
+	with(vortex){
+		auto radius=rangedAttack.effectRange;
+		auto total=cast(int)(duration*updateFPS);
+		bool raining=frame>updateFPS/2&&frame<total-updateFPS;
+		if(frame<total-updateFPS/2){ // drops (drawn green by the renderer): x,y,z relative to the centre
+			foreach(i;0..(raining?6:1)){
+				auto a=state.uniform(0.0f,2.0f*pi!float), r=sqrt(state.uniform(0.0f,1.0f))*radius;
+				auto p=Vector3f(r*cos(a),r*sin(a),acidCloudHeight-state.uniform(0.0f,2.0f));
+				particles~=Particle(p,Vector3f(0.0f,0.0f,-state.uniform(14.0f,18.0f)),state.uniform(0.7f,1.2f),0);
+			}
+		}
+		for(int i=0;i<particles.length;){
+			with(particles[i]){
+				position+=velocity/updateFPS;
+				++frame;
+				auto ground=state.getHeight(vortex.position+Vector3f(position.x,position.y,0.0f))-vortex.position.z;
+				if(position.z<=ground){ // a hiss of fumes where it lands
+					if(state.enableParticles&&!state.uniform(4)){
+						auto smoke=SacParticle!B.get(ParticleType.smoke);
+						auto p=vortex.position+Vector3f(position.x,position.y,ground+0.2f);
+						state.addParticle(.Particle!B(smoke,p,Vector3f(0.0f,0.0f,0.6f),0.6f,cast(int)(0.8f*updateFPS),0));
+					}
+					if(i+1<particles.length) swap(particles[i],particles[$-1]);
+					particles.length=particles.length-1;
+					continue;
+				}
+			}
+			i++;
+		}
+		if(raining&&frame%(updateFPS/4)==0){
+			Vector3f[2] hitbox=[Vector3f(position.x-radius,position.y-radius,position.z-10.0f),Vector3f(position.x+radius,position.y+radius,position.z+acidCloudHeight)];
+			static void burn(ProximityEntry target,ObjectState!B state,VortexEffect!B* vortex,float radius){
+				state.movingObjectById!((ref obj,vortex,radius,state){
+					if(!obj.isHydroEnemy(vortex.side,state)) return;
+					if(obj.creatureState.mode.among(CreatureMode.dead,CreatureMode.dying)) return;
+					if((obj.position.xy-vortex.position.xy).length>radius) return;
+					dealDamage(obj,acidRainDamagePerSecond/4.0f,vortex.attacker,vortex.side,DamageMod.hydroAcid,state);
+				},(){})(target.id,vortex,radius,state);
+			}
+			collisionTargets!burn(hitbox,state,&vortex,radius);
+		}
+		return ++frame<=total;
+	}
+}
