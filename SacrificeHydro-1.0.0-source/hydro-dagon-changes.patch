diff --git a/src/dagon/core/application.d b/src/dagon/core/application.d
index 4fd5a91..b6d137a 100644
--- a/src/dagon/core/application.d
+++ b/src/dagon/core/application.d
@@ -46,6 +46,10 @@ import derelict.freetype.ft;
 
 import dagon.core.event;
 
+// Hydro mod: frame pacing, set before the application is made
+__gshared int swapInterval = -1; // -1: adaptive vsync (falls back to 1), 1: vsync, 0: off
+__gshared int fpsLimit = 0;       // frames per second at most (0: no limit)
+
 void exitWithError(string message)
 {
     writeln(message);
@@ -212,12 +216,14 @@ class Application: EventListener
         if (window is null)
             exitWithError("Failed to create window: " ~ to!string(SDL_GetError()));
 
-        SDL_GL_SetSwapInterval(1);
-
         glcontext = SDL_GL_CreateContext(window);
         if (glcontext is null)
             exitWithError("Failed to create GL context: " ~ to!string(SDL_GetError()));
 
+        // Hydro mod: the swap interval needs the context (it was set before it, so it never applied)
+        if (SDL_GL_SetSwapInterval(swapInterval) != 0 && swapInterval == -1)
+            SDL_GL_SetSwapInterval(1);
+
         SDL_GL_MakeCurrent(window, glcontext);
 
         GLVersion loadedVersion = DerelictGL3.reload();
@@ -285,12 +291,28 @@ class Application: EventListener
     {
         onRender(); // for lazy initialization
         foreach(i;0..2) eventManager.update();
+        import core.time: MonoTime, dur;
+        import core.thread: Thread;
+        auto nextFrame = MonoTime.currTime;
         while(eventManager.running)
         {
             beginRender();
             onUpdate(eventManager.deltaTime);
             onRender();
             endRender();
+            if (fpsLimit > 0) // Hydro mod: frame rate cap
+            {
+                nextFrame += dur!"hnsecs"(10_000_000 / fpsLimit);
+                auto now = MonoTime.currTime;
+                if (nextFrame > now)
+                {
+                    auto wait = nextFrame - now;
+                    if (wait > dur!"msecs"(2)) Thread.sleep(wait - dur!"msecs"(1));
+                    while (MonoTime.currTime < nextFrame) {}
+                }
+                else if (now - nextFrame > dur!"msecs"(100))
+                    nextFrame = now;
+            }
         }
     }
 
