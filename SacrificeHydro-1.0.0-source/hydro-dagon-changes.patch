                 res = tonemapReinhard(res, exposure);
 
+            // Hydro mod: colour grading
+            float luma = dot(res, vec3(0.2126, 0.7152, 0.0722));
+            res = mix(vec3(luma), res, saturation);
+            res = clamp((res - 0.5) * contrast + 0.5, 0.0, 1.0);
+
             if (useVignette)
                 res = mix(res, res * texture(vignette, vec2(texCoord.x, 1.0 - texCoord.y)).rgb, 0.8);
 
