                 res = res / usedSamples;
             }
 
-            if (tonemapFunction == 2)
+            if (tonemapFunction == 3)
+                res = pow(clamp(res * exposure, 0.0, 1.0), vec3(1.0 / 2.2));
+            else if (tonemapFunction == 2)
                 res = tonemapACES(res, exposure);
             else if (tonemapFunction == 1)
                 res = tonemapHable(res, exposure);
